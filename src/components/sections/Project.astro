---
import project1 from '../../assets/images/project-1.png';
import project2 from '../../assets/images/project-2.png';
---

<section id="projects" class="py-24 relative z-10 bg-[var(--color-bg-soft)]/20 border-t border-[var(--color-border)]/50">
  <div class="container max-w-6xl">
    
    <div class="flex items-center gap-4 mb-16">
      <h2 class="text-3xl md:text-4xl fw-bold flex items-center gap-3 tracking-tight">
        <span class="text-lg md:text-xl font-mono text-[var(--color-primary)] opacity-80">02.</span>
        System Outputs
      </h2>
      <div class="flex-1 h-[1px] bg-[var(--color-border)] ml-2 md:ml-6"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <div class="card group flex flex-col overflow-hidden p-0 hover:border-[var(--color-primary)] transition-all duration-500">
        <div class="h-56 bg-[var(--color-border)]/30 overflow-hidden relative">
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-card)] to-transparent z-10"></div>
          
          <div class="absolute top-4 right-4 z-20 px-3 py-1 bg-[var(--color-bg)]/80 backdrop-blur-md border border-[var(--color-border)] rounded-full text-[10px] font-mono text-muted">
            AUG 2025
          </div>
          
          <img 
            src={project2.src} 
            alt="Avisena Hospital HRIS" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100" 
          />
        </div>
        
        <div class="p-8 flex-1 flex flex-col">
          <h3 class="text-2xl fw-bold text-[var(--color-text)] mb-3 group-hover:text-[var(--color-primary)] transition-colors tracking-tight">
            Avisena Hospital HRIS
          </h3>
          <p class="text-muted text-md leading-relaxed mb-8 flex-1">
            An integrated Human Resource Information System for Avisena General Hospital. Designed to streamline employee data management, automating attendance tracking, leave requests, and overtime calculations.
          </p>
          <div class="flex flex-wrap gap-2 mt-auto">
            <span class="px-3 py-1 bg-[var(--color-primary)]/5 text-[var(--color-primary)] border border-[var(--color-primary)]/20 rounded text-xs font-mono">React.js</span>
            <span class="px-3 py-1 bg-[var(--color-primary)]/5 text-[var(--color-primary)] border border-[var(--color-primary)]/20 rounded text-xs font-mono">Express.js</span>
            <span class="px-3 py-1 bg-[var(--color-primary)]/5 text-[var(--color-primary)] border border-[var(--color-primary)]/20 rounded text-xs font-mono">React Native</span>
            <span class="px-3 py-1 bg-[var(--color-primary)]/5 text-[var(--color-primary)] border border-[var(--color-primary)]/20 rounded text-xs font-mono">PostgreSQL</span>
          </div>
        </div>
      </div>

      <div class="card group flex flex-col overflow-hidden p-0 hover:border-[var(--color-primary)] transition-all duration-500">
        <div class="h-56 bg-[var(--color-border)]/30 overflow-hidden relative">
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-card)] to-transparent z-10"></div>
          
          <div class="absolute top-4 right-4 z-20 px-3 py-1 bg-[var(--color-bg)]/80 backdrop-blur-md border border-[var(--color-border)] rounded-full text-[10px] font-mono text-muted">
            FEB 2025
          </div>
          
          <img 
            src={project1.src} 
            alt="SMKN 1 Cimahi E-Library" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100" 
          />
        </div>
        
        <div class="p-8 flex-1 flex flex-col">
          <h3 class="text-2xl fw-bold text-[var(--color-text)] mb-3 group-hover:text-[var(--color-primary)] transition-colors tracking-tight">
            SMKN 1 Cimahi E-Library
          </h3>
          <p class="text-muted text-md leading-relaxed mb-8 flex-1">
            A digital library management system aimed at streamlining book circulation. It empowers school librarians to efficiently manage book inventories, memberships, and track borrowing/returning transaction histories.
          </p>
          <div class="flex flex-wrap gap-2 mt-auto">
            <span class="px-3 py-1 bg-[var(--color-primary)]/5 text-[var(--color-primary)] border border-[var(--color-primary)]/20 rounded text-xs font-mono">Laravel</span>
            <span class="px-3 py-1 bg-[var(--color-primary)]/5 text-[var(--color-primary)] border border-[var(--color-primary)]/20 rounded text-xs font-mono">Bootstrap 5</span>
            <span class="px-3 py-1 bg-[var(--color-primary)]/5 text-[var(--color-primary)] border border-[var(--color-primary)]/20 rounded text-xs font-mono">MySQL</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>