---
// Nanti kamu bisa import gambar aslimu di sini
// import project1 from '../../assets/images/project1.jpg';
---

<section id="projects" class="py-24 relative z-10 bg-[var(--color-bg-soft)]/20 border-t border-[var(--color-border)]/50">
  <div class="container max-w-6xl">
    
    <div class="flex items-center gap-4 mb-16">
      <h2 class="text-3xl md:text-4xl fw-bold flex items-center gap-3 tracking-tight">
        <span class="text-lg md:text-xl font-mono text-[var(--color-primary)] opacity-80">02.</span>
        System Outputs
      </h2>
      <div class="flex-1 h-[1px] bg-[var(--color-border)] ml-2 md:ml-6"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <div class="card group flex flex-col overflow-hidden p-0 hover:border-[var(--color-primary)] transition-all duration-500">
        <div class="h-48 bg-[var(--color-border)]/30 overflow-hidden relative">
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-card)] to-transparent z-10"></div>
          <div class="w-full h-full flex items-center justify-center font-mono text-muted/50 text-sm">Image Placeholder</div>
        </div>
        
        <div class="p-6 flex-1 flex flex-col">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl fw-bold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors">Carwash Management System</h3>
            <a href="#" class="text-muted hover:text-[var(--color-primary)] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
          <p class="text-muted text-sm leading-relaxed mb-6 flex-1">
            A fullstack web application to manage bookings, track services, and handle customer data efficiently. Built with clean architecture and responsive design.
          </p>
          <div class="flex flex-wrap gap-2 mt-auto">
            <span class="px-2 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded text-xs font-mono">Next.js</span>
            <span class="px-2 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded text-xs font-mono">PostgreSQL</span>
            <span class="px-2 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded text-xs font-mono">Tailwind</span>
          </div>
        </div>
      </div>

      <div class="card group flex flex-col overflow-hidden p-0 hover:border-[var(--color-primary)] transition-all duration-500">
        <div class="h-48 bg-[var(--color-border)]/30 overflow-hidden relative">
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-card)] to-transparent z-10"></div>
          <div class="w-full h-full flex items-center justify-center font-mono text-muted/50 text-sm">Image Placeholder</div>
        </div>
        
        <div class="p-6 flex-1 flex flex-col">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl fw-bold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors">3D Character Topology</h3>
            <a href="#" class="text-muted hover:text-[var(--color-primary)] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
          <p class="text-muted text-sm leading-relaxed mb-6 flex-1">
            High-poly sculpting and retopology for optimized rendering. Focused on edge flow, UV mapping, and preparing models for game engine integration.
          </p>
          <div class="flex flex-wrap gap-2 mt-auto">
            <span class="px-2 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded text-xs font-mono">Blender</span>
            <span class="px-2 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded text-xs font-mono">Sculpting</span>
          </div>
        </div>
      </div>

      <div class="card group flex flex-col overflow-hidden p-0 hover:border-[var(--color-primary)] transition-all duration-500">
        <div class="h-48 bg-[var(--color-border)]/30 overflow-hidden relative">
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-card)] to-transparent z-10"></div>
          <div class="w-full h-full flex items-center justify-center font-mono text-muted/50 text-sm">Image Placeholder</div>
        </div>
        
        <div class="p-6 flex-1 flex flex-col">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl fw-bold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors">Void/Core Pixel Aesthetics</h3>
            <a href="#" class="text-muted hover:text-[var(--color-primary)] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
          <p class="text-muted text-sm leading-relaxed mb-6 flex-1">
            A collection of 2D pixel art assets and environment designs focused on dark, logic-core aesthetics, meant for an upcoming indie game prototype.
          </p>
          <div class="flex flex-wrap gap-2 mt-auto">
            <span class="px-2 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded text-xs font-mono">Pixel Art</span>
            <span class="px-2 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded text-xs font-mono">Indie Dev</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>