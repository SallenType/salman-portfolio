---
---

<section id="contact" class="relative z-10">
  <div class="container max-w-5xl">
    
    <div class="flex items-center gap-4 mb-16">
      <h2 class="text-3xl md:text-4xl fw-bold flex items-center gap-3 tracking-tight">
        <span class="text-lg md:text-xl font-mono text-[var(--color-primary)] opacity-80">03.</span>
        Initialize Contact
      </h2>
      <div class="flex-1 h-[1px] bg-[var(--color-border)] ml-2 md:ml-6"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center bg-[var(--color-card)] border border-[var(--color-border)] p-8 md:p-14 rounded-2xl relative overflow-hidden">
      
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-[var(--color-primary)]/10 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="space-y-6 relative z-10">
        <h3 class="text-3xl md:text-4xl fw-bold text-[var(--color-text)] tracking-tight">Open a <br/><span class="text-[var(--color-primary)]">Connection.</span></h3>
        <p class="text-muted leading-relaxed text-lg max-w-md">
          Whether you have a question, a project idea, or just want to discuss Fullstack Web Development, my inbox is always open.
        </p>
        <div class="flex items-center gap-3 font-mono text-xs text-muted pt-4">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
          </span>
          System actively monitoring incoming transmissions.
        </div>
      </div>

      <div class="flex flex-col gap-4 relative z-10 lg:pl-10 lg:border-l border-[var(--color-border)]/50">
        
        <div class="text-xs font-mono text-muted uppercase tracking-wider mb-2">/ Communication Nodes</div>

        <a href="mailto:salmanhh125@gmail.com" class="group flex items-center justify-between p-5 rounded-xl bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-all duration-300">
          <div class="flex items-center gap-4">
            <div class="text-[var(--color-primary)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div>
              <span class="block text-sm font-mono text-muted mb-1 group-hover:text-[var(--color-primary)] transition-colors">Direct Email</span>
              <span class="block text-[var(--color-text)] fw-medium tracking-wide">salmanhh125@gmail.com</span>
            </div>
          </div>
          <span class="text-[var(--color-border)] group-hover:text-[var(--color-primary)] transition-colors group-hover:translate-x-1">→</span>
        </a>

        <a href="https://github.com/SallenType" class="group flex items-center justify-between p-5 rounded-xl bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-[var(--color-text)] transition-all duration-300">
          <div class="flex items-center gap-4">
            <div class="text-muted group-hover:text-[var(--color-text)] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            </div>
            <div>
              <span class="block text-[var(--color-text)] fw-medium tracking-wide">GitHub Repository</span>
            </div>
          </div>
          <span class="text-[var(--color-border)] group-hover:text-[var(--color-text)] transition-colors group-hover:translate-x-1">↗</span>
        </a>

        <a href="https://www.instagram.com/mshananh15_/" class="group flex items-center justify-between p-5 rounded-xl bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-[#E1306C] transition-all duration-300">
          <div class="flex items-center gap-4">
            <div class="text-muted group-hover:text-[#E1306C] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </div>
            <div>
              <span class="block text-[var(--color-text)] fw-medium tracking-wide">My Instagram</span>
            </div>
          </div>
          <span class="text-[var(--color-border)] group-hover:text-[#E1306C] transition-colors group-hover:translate-x-1">↗</span>
        </a>

        <a href="https://www.linkedin.com/in/muhammad-salman-salman-hanan-889ba3395/" class="group flex items-center justify-between p-5 rounded-xl bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-[#0077B5] transition-all duration-300">
          <div class="flex items-center gap-4">
            <div class="text-muted group-hover:text-[#0077B5] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </div>
            <div>
              <span class="block text-[var(--color-text)] fw-medium tracking-wide">My LinkedIn</span>
            </div>
          </div>
          <span class="text-[var(--color-border)] group-hover:text-[#0077B5] transition-colors group-hover:translate-x-1">↗</span>
        </a>

      </div>

    </div>
  </div>
</section>