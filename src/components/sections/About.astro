---
---

<section id="about" class="relative z-10 pt-12 pb-24">
  <div class="container max-w-6xl">
    
    <div class="flex items-center gap-4 mb-12">
      <h2 class="text-3xl md:text-4xl fw-bold flex items-center gap-3 tracking-tight">
        <span class="text-lg md:text-xl font-mono text-[var(--color-primary)] opacity-80">01.</span>
        System Core
      </h2>
      <div class="flex-1 h-[1px] bg-[var(--color-border)] ml-2 md:ml-6"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      
      <div class="space-y-6">
        <p class="text-muted text-lg leading-relaxed">
          I am a software engineer focused on building robust fullstack architectures and interactive digital experiences. My core interest lies in bridging strict backend logic with engaging interfaces.
        </p>
        <p class="text-muted text-lg leading-relaxed">
          Whether setting up relational databases, structuring clean code, or exploring 3D modeling and game development, my goal is always to build scalable and thoughtful systems.
        </p>
        
        <div class="flex gap-6 pt-4 border-t border-[var(--color-border)] mt-6">
          <div>
            <span class="block text-2xl fw-bold text-[var(--color-text)]">Web</span>
            <span class="text-xs font-mono text-muted uppercase tracking-wider">Fullstack Dev</span>
          </div>
          <div class="w-[1px] bg-[var(--color-border)]"></div>
          <div>
            <span class="block text-2xl fw-bold text-[var(--color-text)]">3D</span>
            <span class="text-xs font-mono text-muted uppercase tracking-wider">Interactive</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        
        <div class="card p-5 hover:border-[var(--color-primary)] transition-all">
          <h3 class="text-sm fw-bold text-[var(--color-text)] mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span> Languages
          </h3>
          <div class="flex flex-wrap gap-y-2 gap-x-3 text-sm text-muted font-mono">
            <span>TypeScript</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>JavaScript</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Python</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Java</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>C#</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>PHP</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>SQL</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>HTML/CSS</span>
          </div>
        </div>

        <div class="card p-5 hover:border-[var(--color-primary)] transition-all">
          <h3 class="text-sm fw-bold text-[var(--color-text)] mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span> Frameworks & DB
          </h3>
          <div class="flex flex-wrap gap-y-2 gap-x-3 text-sm text-muted font-mono">
            <span>Next.js</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>React/Vite</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Spring Boot</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Express.js</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Laravel</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>PostgreSQL</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>MySql</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Firebase</span>
          </div>
        </div>

        <div class="card p-5 hover:border-[var(--color-primary)] transition-all">
          <h3 class="text-sm fw-bold text-[var(--color-text)] mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span> Creative Tools
          </h3>
          <div class="flex flex-wrap gap-y-2 gap-x-3 text-sm text-muted font-mono">
            <span>Blender</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Godot</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Aseprite</span>
            <span class="text-[var(--color-border)]">|</span>
            <span>Git</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>